# envrc.example
#
# Optional: per-project profile switching using direnv.
# https://direnv.net  —  brew install direnv / apt install direnv
#
# YOU PROBABLY DO NOT NEED THIS.
# ------------------------------
# The shell integration already switches profiles per directory, with no extra
# dependency and no per-project approval step:
#
#     eval "$(claude-profiles shell-init zsh)"   # in your shell rc
#     cd ~/code/agency-saas
#     claude-profiles use work                   # writes .claude-profile
#
# This file is for people who already run direnv and would rather keep all
# their per-project environment in one place.
#
# HOW TO USE
# ----------
#   1. Copy into the project root as `.envrc`:
#
#          cp shell/envrc.example ~/code/agency-saas/.envrc
#
#   2. Change `work` below to your profile name.
#
#   3. direnv blocks unknown .envrc files by design. Approve it:
#
#          cd ~/code/agency-saas && direnv allow
#
#   4. Confirm:  claude-profiles whoami
#
# Add `.envrc` to that project's .gitignore. It contains no secret — the
# token, if the profile needs one, is read from the OS secret store at use
# time and never written here — but your teammates do not want your profile
# config either way.
# ---------------------------------------------------------------------------

# One line does it. `claude-profiles env` emits the exports for this profile,
# reading them from the registry — so there is nothing here to keep in step
# when you rename a profile or move its config directory.
#
# It exits non-zero and prints nothing usable if the profile is not
# registered, which is why the output is captured before being eval'd:
# `eval "$(cmd)"` reports the status of the eval, not of cmd, and would
# silently leave you on your primary account.
if _cp_env="$(claude-profiles env work 2>/dev/null)"; then
  eval "$_cp_env"
  unset _cp_env
else
  echo "WARNING: no 'work' profile registered — Claude Code will use your PRIMARY account here." >&2
  echo "         Fix: claude-profiles add work" >&2
fi
